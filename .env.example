# 값은 .env.local(저장소에 올라가지 않음)과 Vercel 환경변수에만 넣습니다.
# 쏘웰라(app.ssolwellnesshouse.com)·디저트 테스트와 "같은" Supabase 프로젝트 값을 씁니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용(절대 NEXT_PUBLIC_ 붙이지 않기). 타로 세션 저장에 씁니다.
SUPABASE_SERVICE_ROLE_KEY=
# 고민 분류·카드별 연결 한 줄(AI). 비어 있으면 AI 없이(미작성 모드 문장으로) 결과가 나옵니다.
OPENAI_API_KEY=
# 선택: 저비용 모델 이름(기본 gpt-5.6-luna — 쏘웰라와 같은 모델)
# TAROT_AI_MODEL=
# 선택: 카카오톡 카드 공유(공개돼도 되는 JavaScript 키 — 쏠 아스트로 하우스와 같은 카카오 앱 키를 써도 됨).
# 카카오 개발자센터 → 내 애플리케이션 → 플랫폼 → Web에 https://tarot.ssolwellnesshouse.com 을 등록해야 동작.
# 비어 있으면 휴대폰 공유창·링크 복사로 공유합니다.
NEXT_PUBLIC_KAKAO_JS_KEY=
# 선택: 공유 링크·미리보기 그림에 쓰는 사이트 주소(기본 https://tarot.ssolwellnesshouse.com)
# NEXT_PUBLIC_SITE_URL=
